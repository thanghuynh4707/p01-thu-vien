package library;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.nio.file.Files;
import java.nio.file.StandardCopyOption;

public class FileStorage {

    private String filePath;

    public FileStorage(String filePath) {
        if (filePath == null || filePath.trim().isEmpty()) {
            throw new IllegalArgumentException("Đường dẫn file không được để trống.");
        }
        this.filePath = filePath.trim();
    }

    public String getFilePath() {
        return this.filePath;
    }

    public void setFilePath(String filePath) {
        if (filePath == null || filePath.trim().isEmpty()) {
            throw new IllegalArgumentException("Đường dẫn file không được để trống.");
        }
        this.filePath = filePath.trim();
    }

    public boolean exists() {
        return new File(this.filePath).isFile();
    }

    public void save(LibraryService service) {
        if (service == null) {
            throw new IllegalArgumentException("Không có dữ liệu để lưu.");
        }
        File target = new File(this.filePath);
        File parent = target.getAbsoluteFile().getParentFile();
        if (parent != null && !parent.exists() && !parent.mkdirs()) {
            throw new IllegalStateException("Không tạo được thư mục: " + parent.getPath());
        }
        File temp = new File(this.filePath + ".tmp");
        try (ObjectOutputStream out = new ObjectOutputStream(new FileOutputStream(temp))) {
            out.writeObject(service);
        } catch (IOException e) {
            throw new IllegalStateException("Chưa lưu được dữ liệu: " + e.getMessage());
        }
        try {
            Files.move(temp.toPath(), target.toPath(), StandardCopyOption.REPLACE_EXISTING);
        } catch (IOException e) {
            throw new IllegalStateException("Chưa lưu được dữ liệu: " + e.getMessage());
        }
    }

    public LibraryService load() {
        try (ObjectInputStream in = new ObjectInputStream(new FileInputStream(this.filePath))) {
            Object obj = in.readObject();
            if (!(obj instanceof LibraryService)) {
                throw new IllegalStateException("File dữ liệu không đúng định dạng: " + this.filePath);
            }
            return (LibraryService) obj;
        } catch (IOException e) {
            throw new IllegalStateException("Không đọc được file " + this.filePath + ": " + e.getMessage());
        } catch (ClassNotFoundException e) {
            throw new IllegalStateException("File dữ liệu không tương thích với chương trình: " + e.getMessage());
        }
    }
}
